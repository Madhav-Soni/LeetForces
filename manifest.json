{
  "manifest_version": 3,
  "name": "LeetForces",
  "version": "1.0.0",
  "description": "Codeforces code editor pre-filling, problem context extraction, sample test suite, and submission form integration.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://*.codeforces.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/problemset/problem/*/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://codeforces.com/group/*/contest/*/problem/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
