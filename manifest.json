{
  "manifest_version": 3,
  "name": "LeetForces",
  "version": "1.0.0",
  "description": "Codeforces code editor pre-filling, problem context extraction, sample test suite, submission form integration, and real-time verdict tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://*.codeforces.com/*",
    "https://emkc.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/problemset/problem/*/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://codeforces.com/group/*/contest/*/problem/*"
      ],
      "js": ["dist/content.bundle.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*.js",
        "dist/*.js"
      ],
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ]
    }
  ]
}
